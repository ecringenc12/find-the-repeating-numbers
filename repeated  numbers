#include <stdio.h>
#include <stdlib.h>
int main() {
	int al[10];
	int i;
	int sayac=0;
	int a;
	for(i=0;i<=9;i++)
	{
		printf("%d. sayi al-> ",i+1);
		scanf("%d",&al[i]);
	}
	for(i=0;i<=9;i++)
	{
		for(a=0;a<=9;a++)
		{
			if(al[i]==al[a])
			{
				sayac=sayac+1;
			}
		}
		printf("%d sayisi %d kere tekrar ediyor.\n",al[i],sayac);
		sayac=0;
	}
	
	return 0;
}
